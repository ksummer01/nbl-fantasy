rules_version = '2';

// Hoop Ladder — Firestore security rules.
//
// What these do: only someone the browser has signed in (anonymously) can
// read or write, and they can only touch documents under /leagues/.
// What these do NOT do: they do not stop one league member from editing
// another league's data. Anyone who has your site address can sign in
// anonymously. This is a rule set for a group of mates, not a bank.
//
// Paste this whole file into: Firebase console -> Firestore Database ->
// Rules -> replace everything -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    match /leagues/{leagueId} {
      allow read, write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
